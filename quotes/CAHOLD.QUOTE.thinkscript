#
# This is a refactorted ThinkScript for identifying:
#  - close above high of a low day (CAHOLD)
#
# original: https://tos.mx/3Kykh6C
#  - refactor for readability
#  - fixed b0rk logic
#

def upTrend = ExpAverage(close, 10) > ExpAverage(close, 50);

def close_tday = close[0]; # today
def low_yday = low[1]; # yesterday
def low_2day = low[2]; # 2 days ago
def low_3day = low[3]; # 3 days ago
def high_yday = high[1];
def high_2day = high[2];
def high_3day = high[3];

def reversal = low_yday <= Lowest(low, 3) and close_tday > high_yday
            or low_2day <= Lowest(low, 3) and close_tday > high_2day
            or low_3day <= Lowest(low, 3) and close_tday > high_3day;

plot output = if upTrend and reversal then 1 else 0;

AssignBackgroundColor(
    if output == 1
    then Color.GREEN
    else Color.BLACK
);
